# ─────────────────────────────────────────────────────────────────────────────
# Swavio Frontend Client Environment Variables
# Copy this file to client/.env for local development
# ─────────────────────────────────────────────────────────────────────────────

# Backend API server URL (Render in production, localhost in development)
REACT_APP_API_URL=https://swavio-backend.onrender.com

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Jitsi 8x8.vc vpaas tenant identifier
REACT_APP_JITSI_TENANT=vpaas-magic-cookie-46c16990a7ac4b0795645bbc33e57d74

# Development server settings
PORT=3000
HOST=0.0.0.0
