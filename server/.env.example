# ─────────────────────────────────────────────────────────────────────────────
# Swavio Backend Server Environment Variables
# Copy this file to server/.env and fill in your confidential keys
# ⚠️ NEVER COMMIT THE REAL .env FILE OR SECRETS TO SOURCE CONTROL
# ─────────────────────────────────────────────────────────────────────────────

# Server Port (Render sets this dynamically)
PORT=5000

# MongoDB Atlas connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/swavio?retryWrites=true&w=majority

# JWT signing secret (use a secure random string, e.g.: `openssl rand -hex 64`)
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed CORS origins (comma-separated, without trailing slashes)
ALLOWED_ORIGINS=https://swavio.vercel.app,http://localhost:3000

# Google OAuth 2.0 Client ID (for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary credentials (for profile avatars & chat attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Groq API Key (for LLM-powered quiz generation)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Jitsi as a Service (8x8.vc) configuration
JITSI_TENANT=vpaas-magic-cookie-46c16990a7ac4b0795645bbc33e57d74
JITSI_KID=vpaas-magic-cookie-46c16990a7ac4b0795645bbc33e57d74/xxxxxxxx
# RSA private key (PEM format). In Render environment variables, store with escaped `\n`:
JITSI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
